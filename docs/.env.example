# Template for a local .env file with your KNMI API keys.
# Copy to ".env" (which is gitignored), fill in your keys, and never commit
# the real file. Load it in a notebook/script with python-dotenv:
#
#     from dotenv import load_dotenv
#     load_dotenv()  # pip install knmidata[dotenv]
#
# Alternative without .env: export the variables in your shell, or point
# KNMI_API_KEY_FILE / KNMI_EDR_KEY_FILE at a file containing the key
# (chmod 600) instead of setting the key itself.
#
# On GitHub Actions, do not use .env: add the key as a repository secret
# (Settings > Secrets and variables > Actions, e.g. "KNMI_API_KEY") and pass
# it to the workflow step as an env var — see .github/workflows/notebooks.yaml,
# which executes the docs notebooks in CI. GitHub masks secret values in logs.

# KNMI_API_KEY=
# KNMI_OPEN_DATA_KEY=
# KNMI_EDR_KEY=
